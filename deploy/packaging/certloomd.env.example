# certloomd settings (installed as /etc/certloom/certloomd.env, mode 0640).
# docs/runbooks/install-packages.md explains each step.

# Runtime role (certloom_app), not the owner role.
CERTLOOM_DATABASE_URL=postgres://certloom_app:CHANGE-ME@127.0.0.1:5432/certloom?sslmode=verify-full

CERTLOOM_LISTEN=0.0.0.0:8443
CERTLOOM_TLS_CERT=/etc/certloom/tls/server.crt
CERTLOOM_TLS_KEY=/etc/certloom/tls/server.key

# Key-encryption key for stored credentials (32 random bytes, base64).
# Create with: certloomd gen-kek > /etc/certloom/kek (then root:certloom 0640)
CERTLOOM_KEK_FILE=/etc/certloom/kek

# Agent listener (mutual TLS). Agents dial out to it; the name must be the
# one agents use to reach this host.
CERTLOOM_AGENT_LISTEN=0.0.0.0:8444
CERTLOOM_AGENT_SERVER_NAMES=certloom.example.internal
CERTLOOM_AGENT_PUBLIC_URL=https://certloom.example.internal:8444

CERTLOOM_LOG_LEVEL=info

# Optional: OIDC sign-in.
#CERTLOOM_OIDC_ISSUER=
#CERTLOOM_OIDC_CLIENT_ID=
#CERTLOOM_OIDC_CLIENT_SECRET_REF=
#CERTLOOM_OIDC_REDIRECT_URL=
#CERTLOOM_OIDC_CLI_CLIENT_ID=
