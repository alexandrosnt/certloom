# Copy to .env and replace every value. Never commit .env.
# Generate passwords with e.g.:  openssl rand -base64 32
CERTLOOM_OWNER_DB_PASSWORD=change-me-owner
CERTLOOM_APP_DB_PASSWORD=change-me-app
# Address published on the host. Keep 127.0.0.1 unless a reverse proxy or
# firewall restricts access.
CERTLOOM_PUBLISH=127.0.0.1:8443
# Name agents use to reach this host (DNS name or IP). It goes into the agent
# listener certificate and the enrollment command.
CERTLOOM_HOSTNAME=certloom.example.internal
# Agent listener on the host. Agents on other machines need it reachable, e.g.
# 0.0.0.0:8444 behind a firewall that admits only the agent hosts.
CERTLOOM_AGENT_PUBLISH=127.0.0.1:8444
# Optional: secrets referenced by notification channels as env:NAME
CERTLOOM_WEBHOOK_SECRET=
CERTLOOM_SMTP_PASSWORD=

# External audit export (strongly recommended). Send events to a collector
# the database administrator does not control:
#   CERTLOOM_AUDIT_EXPORT=webhook:https://audit-collector.example.internal/certloom
#   CERTLOOM_AUDIT_EXPORT_KEY_REF=env:CERTLOOM_AUDIT_EXPORT_KEY
CERTLOOM_AUDIT_EXPORT=
CERTLOOM_AUDIT_EXPORT_KEY_REF=
CERTLOOM_AUDIT_EXPORT_KEY=

# Single sign-on (optional). Redirect URL: https://<host>:8443/auth/oidc/callback
CERTLOOM_OIDC_ISSUER=
CERTLOOM_OIDC_CLIENT_ID=
CERTLOOM_OIDC_CLIENT_SECRET_REF=env:CERTLOOM_OIDC_CLIENT_SECRET
CERTLOOM_OIDC_CLIENT_SECRET=
CERTLOOM_OIDC_REDIRECT_URL=
CERTLOOM_OIDC_CLI_CLIENT_ID=
